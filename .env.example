# Chave que o cliente manda em `Authorization: Bearer ...`. Vazia = sem auth.
API_KEY=chave-secreta-gpt

# Um perfil de navegador por ID. O e-mail real vem da sessão logada.
ACCOUNTS=conta1,conta2,conta3

DEFAULT_MODEL=gpt-5
MODELS=gpt-5,gpt-5-thinking,gpt-5-instant,gpt-4o,o3

# Segundos
NAV_TIMEOUT=60
EDITOR_TIMEOUT=30
ANSWER_TIMEOUT=600
SLOT_WAIT_TIMEOUT=900

# Aviso de "conta sem sessão" (o mesmo bot dos outros alertas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
